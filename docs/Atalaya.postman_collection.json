{
  "info": {
    "name": "Atalaya API",
    "description": "Colección de pruebas de Atalaya. Ejecute primero la carpeta \"1. Autenticación\": los logins guardan automáticamente {{token}} (admin), {{tokenAnalista}} y {{tokenConsulta}}. La autenticación Bearer de la colección usa {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:52080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenAnalista",
      "value": ""
    },
    {
      "key": "tokenConsulta",
      "value": ""
    },
    {
      "key": "idUsuarioPrueba",
      "value": "5"
    }
  ],
  "item": [
    {
      "name": "0. Salud",
      "item": [
        {
          "name": "Salud (anónimo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/salud",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "salud"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
