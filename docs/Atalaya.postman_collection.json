              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  var datos = pm.response.json();",
                  "  pm.collectionVariables.set(\"token\", datos.token);",
                  "  pm.test(\"Token guardado en la variable token\", function () { pm.expect(datos.token).to.be.a(\"string\"); });",
