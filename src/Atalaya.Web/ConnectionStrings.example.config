<?xml version="1.0" encoding="utf-8"?>
<!--
  Plantilla. Copie este archivo como ConnectionStrings.config (ignorado por git)
  y reemplace CLAVE_DE_ROOT por la clave del usuario root de su MySQL local.
  Si usa otro usuario, cambie también Uid. Requiere MySQL 8.0.16 o superior.
-->
<connectionStrings>
  <add name="Atalaya" connectionString="Server=127.0.0.1;Port=3306;Database=atalaya_acceso;Uid=root;Pwd=CLAVE_DE_ROOT;SslMode=None;AllowPublicKeyRetrieval=true;CharSet=utf8mb4;" providerName="MySql.Data.MySqlClient" />
</connectionStrings>
