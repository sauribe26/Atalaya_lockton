<?xml version="1.0" encoding="utf-8"?>
<!--
  Plantilla de secretos. Copie este archivo como Secretos.config (ignorado por git) y reemplace el valor.
  Jwt:Clave: clave de firma HS256, mínimo 32 caracteres aleatorios (recomendado 64).
  Generarla en PowerShell:
    $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
-->
<appSettings>
  <add key="Jwt:Clave" value="REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA_DE_64_CARACTERES_MINIMO_32" />
</appSettings>
